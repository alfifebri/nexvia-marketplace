# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
TRUST_PROXY=0

# ── Database ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/nexvia_marketplace

# ── JWT (use long, unique, random values in production) ──────────────────────
JWT_ACCESS_SECRET=dev-only_access_02f4f8c1b7a94d6e8c3a5f90d2e7b614
JWT_REFRESH_SECRET=dev-only_refresh_9a1e6c47d3b85f02a8c4e71b6d59f320
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
JWT_ISSUER=nexvia-marketplace
JWT_AUDIENCE=nexvia-web

# ── Cookies ───────────────────────────────────────────────────────────────────
# Production cross-domain (e.g. Vercel + Render): COOKIE_SAME_SITE=none, COOKIE_SECURE=true
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# COOKIE_DOMAIN=.nexvia.dev
COOKIE_ACCESS_NAME=nexvia_access
COOKIE_REFRESH_NAME=nexvia_refresh

# ── CORS (comma separated, no wildcards when credentials are enabled) ────────
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Security / seeding ────────────────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=12
SEED_ADMIN_PASSWORD=Admin@123
SEED_VENDOR_PASSWORD=Vendor@123
SEED_CUSTOMER_PASSWORD=Customer@123
