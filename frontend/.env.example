# Backend API (Express + MongoDB)
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Public site URL used for metadata + canonical links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# "demo" serves the bundled, typed marketplace dataset for catalog/commerce APIs
# that are not yet exposed by the backend. "live" calls the API directly.
NEXT_PUBLIC_API_MODE=demo
